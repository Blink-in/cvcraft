{
  "version": 2,
  "buildCommand": "npm run install:all && npm run build",
  "outputDirectory": "client/dist",
  "framework": "vite",
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/$1" },
    { "src": "/(google[a-z0-9]+\\.html|BingSiteAuth\\.xml|.*\\.txt|.*\\.xml|sitemap\\.xml|robots\\.txt)", "dest": "/$1" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}