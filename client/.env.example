VITE_API_URL=http://localhost:5000/api

# Payment provider secrets belong in your server/Vercel environment, not the Vite client env.
# Required server env vars:
# PAYMENT_PROVIDERS=paystack,flutterwave
# PAYMENT_PRICE_CENTS=250
# PAYMENT_CURRENCY=USD
# PAYMENT_CHECKOUT_TTL_MINUTES=30
# PAYMENT_ALLOWED_REDIRECT_ORIGINS=https://your-domain.com
# PAYSTACK_SECRET_KEY=sk_test_xxx
# FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-xxx
# FLUTTERWAVE_WEBHOOK_SECRET_HASH=your_webhook_secret_hash

# Leave rewarded ad unlocks disabled until the ad reward is verified server-side.
# REWARDED_AD_UNLOCKS_ENABLED=false

# Optional legacy provider, hidden unless you add it to PAYMENT_PROVIDERS.
# LEMON_SQUEEZY_API_KEY=
# LEMON_SQUEEZY_STORE_ID=
# LEMON_SQUEEZY_VARIANT_ID=
# LEMON_SQUEEZY_WEBHOOK_SECRET=
